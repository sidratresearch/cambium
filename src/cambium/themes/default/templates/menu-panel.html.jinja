{# Cambium Theme: Default #}

<div class="menu-panel hidden" id="menu-panel">
  <div class="menu-top-bar header-bar">
    <!-- Re-create the header, but with a different button -->
    <div class="header-left">
      <a href="{{ relative_path_modifier }}index.html" class="header-link site-title">
        {{ site_name }}
      </a>
    </div>
    <div class="header-centre">
      {% if metadata.stage_metadata.PagefindSearch is defined %}
        {% include metadata.stage_metadata.PagefindSearch.searchbar_component %}
      {% endif %}
    </div>
    <div class="header-right">
      <button class="menu-button" id="menu-button-close">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
          <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
          <!-- classic/solid/x -->
          <path
            d="M504.6 148.5C515.9 134.9 514.1 114.7 500.5 103.4C486.9 92.1 466.7 93.9 455.4 107.5L320 270L184.6 107.5C173.3 93.9 153.1 92.1 139.5 103.4C125.9 114.7 124.1 134.9 135.4 148.5L278.3 320L135.4 491.5C124.1 505.1 125.9 525.3 139.5 536.6C153.1 547.9 173.3 546.1 184.6 532.5L320 370L455.4 532.5C466.7 546.1 486.9 547.9 500.5 536.6C514.1 525.3 515.9 505.1 504.6 491.5L361.7 320L504.6 148.5z"
          />
        </svg>
      </button>
    </div>
  </div>
  <nav class="menu-items">{{ menu }}</nav>
</div>
