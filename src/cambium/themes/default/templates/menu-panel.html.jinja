{# Cambium Theme: Default #}

<div class="menu-panel hidden" id="menu-panel">
  <div class="menu-top-bar header-bar">
    <!-- Re-create the header, but with a different button -->
    <div class="header-left">
      <a href="{{ relative_path_modifier }}index.html" class="header-link site-title">
        {{ site_name }}
      </a>
    </div>
    <div class="header-centre">
      {% if metadata.stage_metadata.PagefindSearch is defined %}
        {% include metadata.stage_metadata.PagefindSearch.searchbar_component %}
      {% endif %}
    </div>
    <div class="header-right">
      <button class="menu-button" id="menu-button-close">
        <svg
          class="menu-icon menu-icon-cross"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 640 640"
        >
          <!--!Font Awesome Pro v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2026 Fonticons, Inc.-->
          <path
            d="M508.2 122.3C513.9 115.6 513.1 105.5 506.3 99.8C499.5 94.1 489.5 94.9 483.7 101.7L320 295.2L156.2 101.7C150.5 95 140.4 94.1 133.7 99.8C127 105.5 126.1 115.6 131.8 122.3L299 320L131.8 517.7C126.1 524.4 126.9 534.5 133.7 540.3C140.5 546.1 150.5 545.2 156.2 538.4L320 344.8L483.8 538.3C489.5 545 499.6 545.9 506.4 540.2C513.2 534.5 514 524.4 508.3 517.6L341 320L508.2 122.3z"
          />
        </svg>
      </button>
    </div>
  </div>
  <nav class="menu-items">{{ menu }}</nav>
</div>
